# PawPilot backend — copy to `.env` and adjust for your environment.
#
# pydantic-settings reads this file at app import time. Variables without a
# default in app/config.py are required: the app will fail to import without
# them, including under `make dev` / `uv run uvicorn`.

# ---- Required ---------------------------------------------------------------

# Async Postgres URL. Defaults below point at the local docker-compose stack
# in infra/docker-compose.yml (host port comes from POSTGRES_HOST_PORT,
# default 55433). Username/password/db match the compose file.
DATABASE_URL=postgresql+asyncpg://pawpilot:pawpilot@localhost:55433/pawpilot

# Secret used to sign session JWTs. Generate a fresh value per environment,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=replace-me-with-a-random-secret-at-least-32-bytes

# ---- Optional (defaults shown) ---------------------------------------------

# Origin allowed by CORS / used to build absolute links back to the SPA.
FRONTEND_BASE_URL=http://localhost:3000

# Public base URL of this backend — used to build absolute photo URLs in
# PetRead.photo_url. Match your dev port (default uvicorn is 8000).
BACKEND_BASE_URL=http://localhost:8000

# Directory where uploaded media (pet photos, user avatars) is written.
# Relative paths resolve from the backend working directory.
# MEDIA_ROOT=./media

# Session cookie behaviour. Keep COOKIE_SECURE=false for local HTTP; set to
# true in any environment served over HTTPS.
# COOKIE_NAME=pawpilot_auth
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_MAX_AGE_SECONDS=86400
# JWT_LIFETIME_SECONDS=86400

# ENVIRONMENT=development
